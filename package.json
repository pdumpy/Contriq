{
  "name": "contriq",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "cf workers types && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --env-file-if-exists=.env.local --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:score": "tsx --env-file-if-exists=.env.local scripts/score.ts",
    "db:release": "tsx scripts/release-database.ts",
    "setup": "bash scripts/setup-local.sh",
    "test:e2e": "tsx --env-file-if-exists=.env.local --test tests/e2e/*.test.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vinext/cloudflare": "^1.4.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.8"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  }
}
